<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>DST changes</title>
  <link rel="icon" href="favicon.svg" type="image/svg+xml" />
  <style type="text/css">
    body {
      font: 15px "Myriad Pro", "Helvetica", Arial, sans-serif;
      background: #eee;
      color: #333;
    }
    a {
      color: #111;
    }
    @media (prefers-color-scheme: dark) {
      body {
        background: #333;
        color: #aaa;
      }
      a {
        color: #ccc;
      }
    }
    ul {
      padding: 0;
    }
    li {
      display: inline-block;
      list-style: none;
    }
    #timezones a {
      margin: 0 -2px;
      padding: 0 2px;
      border-radius: 4px;
    }
    .blank {
      color: gray;
    }
    .hover:not(.same) {
      color: orange;
      transition: color 0.2s;
    }
    .same {
      color: rgb(from #76f r g b / 80%);
    }
    .current {
      color: #85f;
      font-weight: bold;
    }
  </style>
  <script>
    const solstices = <%= JSON.dump(solstices.map(&:iso8601)) %>.map(s => new Date(s));
    const localOffsets = solstices.map(d => -d.getTimezoneOffset()).join('/');

    function currentTzName(){
      try {
        return Intl.DateTimeFormat().resolvedOptions().timeZone || undefined;
      } catch (e) {
        return undefined;
      }
    }

    document.addEventListener('mouseover', e => {
      const hovered = e.target.closest('a[data-utc-offsets]');
      if (!hovered) return;

      const hoveredOffsets = hovered.dataset.utcOffsets;
      document.querySelectorAll('a[data-utc-offsets]').forEach(a => {
        a.classList.toggle('hover', a.dataset.utcOffsets === hoveredOffsets)
      })
    });

    document.addEventListener('DOMContentLoaded', () => {
      const tzName = currentTzName();

      document.querySelectorAll('a[data-path]').forEach(a => {
        if (a.innerText === tzName) {
          a.classList.add('current');
        }
        if (a.dataset.utcOffsets === localOffsets) {
          a.classList.add('same');
        }
        a.href = new URL(a.dataset.path, window.location).href.replace(/\w+:/, 'webcal:')
      });
    })
  </script>
</head>
<body>
  <h1>DST-changes.ics</h1>

  <p>
    <a href="https://gitlab.com/ivan-kuchin/DST-changes.ics">DST-changes.ics</a> is made with the help of
    <a href="https://github.com/tzinfo/tzinfo-data">tzinfo-data</a> and
    <a href="https://github.com/icalendar/icalendar">icalendar</a>
    <br>
    You may also want to check <a href="https://ivan-kuchin.gitlab.io/holidays.ics/">holidays.ics</a>
  </p>

  <ul id="timezones">
    <% all.each do |tz| %>
      <li>
        <a class="<%= 'blank' if tz.transitions.empty? %>" data-path="<%= h tz.name %>.ics" data-utc-offsets="<%= solstices.map{ |solstice| tz.period_for(solstice).observed_utc_offset / 60 }.join('/') %>">
          <%= h tz.name %>
        </a>
      </li>
    <% end %>
  </ul>

  <p><a data-path="combined.ics">Transitions for all timezones</a></p>
</body>
</html>
